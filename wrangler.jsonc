/**
 * Cloudflare Workers deployment of Slop Rooster (see README, "Deploy to Cloudflare").
 *
 * Secrets are never stored here. Set them once per Worker with
 * `npx wrangler secret put <NAME>` (or in the dashboard as type "Secret"):
 *
 *   SLOP_ROOSTER_ACCESS_UUID — required; the shared access code creators sign in with.
 *   APP_SESSION_SECRET       — required, at least 32 characters; signs creator session cookies.
 *   SHARE_TOKEN_SECRET       — required, at least 32 characters; signs protected viewing links.
 *   GEMINI_API_KEY           — optional; enables "Generate Markdown".
 *
 * For local `wrangler dev`, the same names go into the gitignored .dev.vars
 * (`npm run cf:setup` generates it; see .dev.vars.example).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slop-rooster",
  // Serves /api/* and the cron; every other path is a static asset from dist/.
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The Vite build (`npm run build`). Build before `wrangler dev` or `wrangler deploy`.
    "directory": "./dist",
    "binding": "ASSETS",
    // /v/<id>, /manage/<id> and every other client route load index.html.
    "not_found_handling": "single-page-application",
    // API routes always reach the Worker, even where an asset path would match.
    "run_worker_first": ["/api/*"],
  },
  // Recordings, upload manifests, sharing settings and Markdown jobs. Schema: migrations-d1/
  // (`npm run cf:migrate`). No database_id on purpose: Wrangler finds the database by name, and
  // `wrangler deploy` creates it when it does not exist yet.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slop-rooster",
      "migrations_dir": "migrations-d1",
    },
  ],
  // Private video bytes (single uploads up to 50 MiB, larger recordings as 8 MiB parts) and
  // small upload transfer records under `_meta/`. Never public: the Worker streams authorized
  // playback itself. `wrangler deploy` creates the bucket when it does not exist yet.
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "slop-rooster-recordings",
    },
  ],
  // Durable Markdown recovery: queued large videos, retries and reconciliation.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
  },
  // Reachable at https://slop-rooster.<your-subdomain>.workers.dev. To use your own domain, add
  //   "routes": [{ "pattern": "rec.example.com", "custom_domain": true }],
  // (the zone must be on the same Cloudflare account) and optionally set workers_dev to false.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    // Protected links carry a permanent viewing token in the query string
    // (/api/recordings/<id>/video?token=…); keep it out of Workers Logs.
    "redact_query_string": true,
  },
}
